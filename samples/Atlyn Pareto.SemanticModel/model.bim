{
  "name": "Atlyn Pareto Samples",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Defects",
        "description": "Invented, disjoint defect categories. Embedded offline data mirrors defect-count.csv.",
        "columns": [
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "DefectCount",
            "dataType": "int64",
            "sourceColumn": "DefectCount",
            "formatString": "#,0",
            "summarizeBy": "sum"
          },
          {
            "name": "ReworkMinutes",
            "dataType": "int64",
            "sourceColumn": "ReworkMinutes",
            "formatString": "#,0",
            "summarizeBy": "sum"
          }
        ],
        "measures": [
          {
            "name": "Total defects",
            "expression": "SUM(Defects[DefectCount])",
            "formatString": "#,0",
            "description": "Bind to Contribution. Additive defect count; total 200 before filters."
          },
          {
            "name": "Total rework minutes",
            "expression": "SUM(Defects[ReworkMinutes])",
            "formatString": "#,0",
            "description": "Optional Tooltip measure; not part of the defect-count denominator."
          }
        ],
        "partitions": [
          {
            "name": "Defects",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(",
                "        type table [Category = nullable text, DefectCount = Int64.Type, ReworkMinutes = Int64.Type],",
                "        {",
                "            {\"Packaging\", 20, 50},",
                "            {\"Design\", 70, 210},",
                "            {\"Surface\", 20, 60},",
                "            {\"Assembly\", 50, 150},",
                "            {\"Labeling\", 20, 40},",
                "            {\"Fastener\", 10, 30},",
                "            {\"Calibration\", 6, 24},",
                "            {null, 4, 12},",
                "            {\"Documentation\", 0, 0}",
                "        }",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "Complaints",
        "description": "Invented, disjoint complaint categories. All costs use one illustrative USD unit. Embedded data mirrors complaint-cost.csv.",
        "columns": [
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "ComplaintCostUSD",
            "dataType": "decimal",
            "sourceColumn": "ComplaintCostUSD",
            "formatString": "\"$\"#,0.00",
            "summarizeBy": "sum"
          },
          {
            "name": "ComplaintCount",
            "dataType": "int64",
            "sourceColumn": "ComplaintCount",
            "formatString": "#,0",
            "summarizeBy": "sum"
          }
        ],
        "measures": [
          {
            "name": "Total complaint cost",
            "expression": "SUM(Complaints[ComplaintCostUSD])",
            "formatString": "\"$\"#,0.00",
            "description": "Bind to Contribution. Additive cost in USD; total 10000 before filters."
          },
          {
            "name": "Total complaints",
            "expression": "SUM(Complaints[ComplaintCount])",
            "formatString": "#,0",
            "description": "Optional Tooltip measure; not part of the cost denominator."
          }
        ],
        "partitions": [
          {
            "name": "Complaints",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(",
                "        type table [Category = text, ComplaintCostUSD = Currency.Type, ComplaintCount = Int64.Type],",
                "        {",
                "            {\"Support\", 900, 9},",
                "            {\"Delivery\", 2500, 25},",
                "            {\"Billing\", 3200, 32},",
                "            {\"Returns\", 900, 9},",
                "            {\"Product quality\", 1500, 15},",
                "            {\"Account\", 400, 4},",
                "            {\"Checkout\", 600, 6},",
                "            {\"Warranty\", 0, 0}",
                "        }",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "CustomerRevenue",
        "description": "Synthetic customer concentration buckets with additive USD revenue and invoice totals. Embedded offline data mirrors customer-revenue.csv and does not contain real customer records.",
        "columns": [
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "RevenueUSD",
            "dataType": "decimal",
            "sourceColumn": "RevenueUSD",
            "formatString": "\"$\"#,0.00",
            "summarizeBy": "sum"
          },
          {
            "name": "InvoiceCount",
            "dataType": "int64",
            "sourceColumn": "InvoiceCount",
            "formatString": "#,0",
            "summarizeBy": "sum"
          }
        ],
        "measures": [
          {
            "name": "Total customer revenue",
            "expression": "SUM(CustomerRevenue[RevenueUSD])",
            "formatString": "\"$\"#,0.00",
            "description": "Bind to Contribution. Additive revenue in USD; total 1000000 before filters."
          },
          {
            "name": "Total invoices",
            "expression": "SUM(CustomerRevenue[InvoiceCount])",
            "formatString": "#,0",
            "description": "Optional Tooltip measure; not part of the revenue denominator."
          }
        ],
        "partitions": [
          {
            "name": "CustomerRevenue",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(",
                "        type table [Category = text, RevenueUSD = Currency.Type, InvoiceCount = Int64.Type],",
                "        {",
                "            {\"Customer portfolio 01 - enterprise field retrofit program\", 250000, 120},",
                "            {\"Customer portfolio 02 - OEM replenishment umbrella\", 180000, 90},",
                "            {\"Customer portfolio 03 - direct digital migration subscriptions\", 140000, 70},",
                "            {\"Customer portfolio 04 - regulated maintenance consortium\", 90000, 60},",
                "            {\"Customer portfolio 05 - multi-site service renewal\", 80000, 45},",
                "            {\"Customer portfolio 06 - national distributor umbrella\", 60000, 30},",
                "            {\"Customer portfolio 07 - national distributor umbrella backup\", 60000, 30},",
                "            {\"Customer portfolio 08 - public sector onboarding pool\", 30000, 25},",
                "            {\"Customer portfolio 09 - partner marketplace rollup\", 25000, 22},",
                "            {\"Customer portfolio 10 - direct ecommerce expansion\", 20000, 20},",
                "            {\"Customer portfolio 11 - warranty conversions archive\", 15000, 18},",
                "            {\"Customer portfolio 12 - seasonal training allocations\", 10000, 17},",
                "            {\"Customer portfolio 13 - long tail reseller cluster alpha\", 8000, 15},",
                "            {\"Customer portfolio 14 - long tail reseller cluster beta\", 7000, 13},",
                "            {\"Customer portfolio 15 - long tail reseller cluster gamma\", 6000, 12},",
                "            {\"Customer portfolio 16 - long tail reseller cluster delta\", 5000, 11},",
                "            {\"Customer portfolio 17 - long tail reseller cluster epsilon\", 4000, 10},",
                "            {\"Customer portfolio 18 - pilot installations retained\", 3000, 9},",
                "            {\"Customer portfolio 19 - archived upsell experiments\", 2500, 8},",
                "            {\"Customer portfolio 20 - procurement bridge accounts\", 2000, 6},",
                "            {\"Customer portfolio 21 - internal chargeback recoveries\", 1000, 4},",
                "            {\"Customer portfolio 22 - legacy portal migrations\", 800, 3},",
                "            {\"Customer portfolio 23 - sandbox evaluation credits\", 700, 2},",
                "            {\"Customer portfolio 24 - dormant framework placeholders\", 0, 0},",
                "            {\"Customer portfolio 25 - zero revenue closed records\", 0, 0}",
                "        }",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Defects\",\"Complaints\",\"CustomerRevenue\"]"
      }
    ]
  }
}
